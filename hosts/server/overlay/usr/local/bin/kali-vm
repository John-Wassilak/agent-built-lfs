#!/bin/bash
# SPDX-License-Identifier: MIT
# agent-built-lfs -- Kali Linux lab guest launcher for `server` (qemu + KVM)
# Copyright (c) 2026 John Wassilak

# Usage, as kalivm (sudo -u kalivm kali-vm ...):
#   kali-vm create IMAGE   import Kali's qemu image (.qcow2, or the .7z it ships in)  (once)
#   kali-vm run            boot Kali
#   kali-vm stop           shut Kali down (guest agent, else ACPI power button)
#   kali-vm reset          throw away every change since create (VM must be stopped)
#
# run is normally started as the kali-vm unit. The screen is VNC on 10.0.0.4:5902
# (wg0 only; TLS, and the password in $VM/vnc.pass, which create writes).
#
# Two NICs, the order the lab sheet asks for:
#   NIC 1, NAT: qemu's user-mode network (libslirp), the qemu equivalent of
#     VirtualBox NAT. Outbound only, no hostfwd. It leaves through enp6s0, the home
#     connection; unlike win11vm, kalivm has no policy routing to wg1.
#   NIC 2, host-only: the tap lab-kali on the bridge lab0, 192.168.56.0/24, which
#     systemd-networkd creates (overlay/etc/systemd/network/50-lab*). The MAC is fixed
#     so networkd's DHCP server always gives Kali 192.168.56.10. The firewall forwards
#     nothing in or out of lab0 (blfs-iptables host override).
#
# Disk: create stores the image as $BASE, read-only, and the guest writes to $DISK,
# a qcow2 overlay backed by it. reset is a new overlay, so a lab can start over from a
# clean Kali without importing the 16G image again.
#
# Host-specific, hence hosts/server/overlay: it names /mnt/big_drive (sda2; / has 24G
# free and the image alone is 16G), wg0's address and lab0's tap. 2 vCPUs and 4G, the
# lab sheet's numbers, which fit beside the Windows guest's 2 and 8G on this 4-core,
# 31G i5-2500K. No new packages: qemu is packages.py seq 268, and bsdtar (libarchive)
# reads the .7z.
#
# One-time setup, as root:
#   useradd -r -M -d /mnt/big_drive/kali -s /sbin/nologin -U -G kvm kalivm
#   install -d -m 750 -o kalivm -g kalivm /mnt/big_drive/kali
# then the networkd files above, `networkctl reload`, and the firewall script.
#
# The file share is /mnt/big_drive/vm-share, the same directory win11-vm gives Windows
# as Z:, so a file dropped there by john or either guest is visible to all three. It
# needs kalivm in both of its ACLs (see win11-vm for the rest of its setup):
#   setfacl -m u:kalivm:rwx -d -m u:kalivm:rwx /mnt/big_drive/vm-share
#   find /mnt/big_drive/vm-share -mindepth 1 -exec setfacl -m u:kalivm:rwx {} +
# The find gives kalivm the files that already exist; new ones inherit the default ACL.
#
# Hardware choices:
#   q35, SeaBIOS -- Kali's qemu image boots with legacy BIOS; no Secure Boot or TPM.
#   -cpu host -- the guest sees the real i5-2500K (AES-NI, AVX), which hashcat and
#     john use.
#   virtio-fs (vhost-user-fs-pci, tag "share") -- $SHARE, served by virtiofsd as
#     kalivm in its namespace sandbox, as win11-vm does. virtiofs is in Kali's kernel.
#     Guest side, once per overlay (`reset` discards it), as root:
#       mkdir -p /mnt/share
#       echo 'share /mnt/share virtiofs defaults,nofail 0 0' >>/etc/fstab
#   Guest RAM is a file in $RAM_DIR, the unit's private huge=advise tmpfs, because
#     vhost-user needs RAM virtiofsd can map; win11-vm explains why memfd gets no THP.
#     Outside the unit it falls back to memfd on 4K pages.
#   virtio-blk, virtio-net, virtio-vga -- all in Kali's kernel. virtio-vga passes the
#     VNC viewer's size to the guest as the connector's preferred mode. Xorg does not
#     switch to it by itself: Kali's xautoresize does, but its stock launcher exits
#     unless the hypervisor is VirtualBox or VMware. The guest needs
#     ~kali/.config/autostart/xautoresize.desktop with Exec=xautoresize, which
#     `reset` discards; recreate it after one.
#   -rtc base=utc -- Linux keeps the RTC in UTC.
#   virtio-rng-pci -- host /dev/urandom for the guest's RNG. The i5-2500K has no RDRAND,
#     so -cpu host gives the guest none; virtio_rng is in Kali's kernel.
#   vhost=on on the lab tap -- the kernel's vhost_net moves the tap's packets, not
#     qemu's main loop (kernel-config.sh, 2026-10-27). /dev/vhost-net is kvm 0660 by
#     systemd's udev rule, and kalivm is in kvm. Without it the tap falls back to
#     userspace. The slirp NIC cannot use vhost.
#   qemu-vdagent (clipboard=on) on the com.redhat.spice.0 port -- copy and paste
#     between the VNC viewer and the guest. qemu's VNC server hands the viewer's
#     clipboard to this chardev, which speaks the spice agent protocol to Kali's
#     spice-vdagent; no spice server involved. Needs qemu built with spice-protocol
#     (packages.py seq 272.5). mouse=off: usb-tablet already gives an absolute pointer.
#     The guest agent (qemu-ga) and spice-vdagent ship in Kali's image and start by
#     themselves when their ports appear.
set -euo pipefail

VM=${KALI_VM_DIR:-/mnt/big_drive/kali}
CPUS=${KALI_CPUS:-2}
MEM=${KALI_MEM:-4G}
VNC_ADDR=${KALI_VNC_ADDR:-10.0.0.4}
LAB_TAP=lab-kali
LAB_MAC=52:54:00:56:00:0a

BASE=$VM/kali-base.qcow2
DISK=$VM/kali.qcow2
MONITOR=$VM/monitor.sock
QGA=$VM/qga.sock
VNC_PASS=$VM/vnc.pass
SHARE=${KALI_SHARE:-/mnt/big_drive/vm-share}
VFS_SOCK=$VM/virtiofs.sock
RAM_DIR=/run/kalivm-ram

die() { echo "kali-vm: $*" >&2; exit 1; }

preflight() {
    [ -c /dev/kvm ] || die "/dev/kvm missing -- is kvm_intel loaded?"
    [ -r /dev/kvm ] && [ -w /dev/kvm ] || die "no access to /dev/kvm -- $(id -un) is not in the kvm group"
    [ -d "$VM" ] && [ -w "$VM" ] || die "$VM is not writable -- see the one-time setup in $0"
}

# Same scheme as win11-vm: DES VNC auth reads 8 characters, no trailing newline.
vnc_password() {
    [ -e "$VNC_PASS" ] && return 0
    local pw
    pw=$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 8) || true
    [ ${#pw} -eq 8 ] || die "could not generate a VNC password"
    (umask 077; printf %s "$pw" >"$VNC_PASS")
    echo "VNC password written to $VNC_PASS"
}

overlay() {
    qemu-img create -f qcow2 -F qcow2 -b "$BASE" "$DISK"
}

create() {
    local img=${1:-}
    preflight
    [ -r "$img" ] || die "usage: kali-vm create kali-linux-*-qemu-amd64.{7z,qcow2} (readable by $(id -un))"
    [ -e "$BASE" ] && die "$BASE already exists; refusing to overwrite"
    case "$img" in
        *.7z)
            # The archive holds one member, the .qcow2. Streamed, so no second copy.
            local member
            member=$(bsdtar -tf "$img" | grep -m1 '\.qcow2$') || die "no .qcow2 inside $img"
            echo "kali-vm: extracting $member (16G, a few minutes)"
            bsdtar -xOf "$img" "$member" >"$BASE.part"
            ;;
        *.qcow2) cp -v "$img" "$BASE.part" ;;
        *) die "want a .7z or .qcow2, got $img" ;;
    esac
    qemu-img check -q "$BASE.part" || die "$BASE.part fails qemu-img check"
    mv "$BASE.part" "$BASE"
    chmod 440 "$BASE"
    overlay
    vnc_password
}

# Same as win11-vm: one connection, exits with qemu, stays in the unit's cgroup.
# The socket wait is 10 s. It was 2 s until 2026-10-27, when a start under load
# (a kernel build finishing, Windows booting) died at 2 s; unloaded it takes 0.03 s.
#
# The translate options are what a Linux guest needs and Windows did not. Unprivileged
# in its namespace, virtiofsd can see only kalivm's own uid, so the guest saw john's
# and win11vm's files as 65534 with no write bit for kali (2026-10-27). squash-host
# shows every host uid/gid to the guest as 1000, Kali's `kali`, so kali owns the whole
# share in the guest. squash-guest records every guest uid/gid as kalivm, which is all
# virtiofsd could create files as anyway. On the host the setgid bit and default ACL
# still make each new file group john, rwx for john, win11vm and kalivm.
start_virtiofsd() {
    [ -d "$SHARE" ] && [ -w "$SHARE" ] || die "$SHARE is not writable by $(id -un) -- see the share setup above"
    rm -f "$VFS_SOCK"
    /usr/libexec/virtiofsd --socket-path="$VFS_SOCK" --shared-dir="$SHARE" \
                           --sandbox=namespace --cache=auto \
                           --translate-uid squash-host:0:1000:4294967295 \
                           --translate-uid squash-guest:0:"$(id -u)":4294967295 \
                           --translate-gid squash-host:0:1000:4294967295 \
                           --translate-gid squash-guest:0:"$(id -g)":4294967295 &
    for _ in $(seq 50); do
        [ -S "$VFS_SOCK" ] && return 0
        sleep 0.2
    done
    die "virtiofsd did not create $VFS_SOCK"
}

ram_backend() {
    if [ -d "$RAM_DIR" ] && [ -w "$RAM_DIR" ]; then
        echo "memory-backend-file,id=mem0,size=$MEM,share=on,mem-path=$RAM_DIR/kali,align=2M,discard-data=on"
    else
        echo "kali-vm: no $RAM_DIR, guest RAM on memfd without hugepages" >&2
        echo "memory-backend-memfd,id=mem0,size=$MEM,share=on"
    fi
}

vhost() {
    if [ -w /dev/vhost-net ]; then
        echo ",vhost=on"
    else
        echo "kali-vm: no writable /dev/vhost-net, lab tap in userspace" >&2
    fi
}

reset() {
    preflight
    [ -e "$BASE" ] || die "no $BASE -- run 'kali-vm create' first"
    [ -S "$MONITOR" ] && python3 -c 'import socket,sys
s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1])' "$MONITOR" 2>/dev/null \
        && die "the VM is running; stop it first"
    rm -f "$DISK"
    overlay
}

run() {
    preflight
    [ -e "$DISK" ] || die "no $DISK -- run 'kali-vm create' first"
    [ -d /sys/class/net/$LAB_TAP ] || die "no $LAB_TAP -- are the lab0 networkd files installed (networkctl reload)?"
    vnc_password
    start_virtiofsd
    exec qemu-system-x86_64 \
        -name kali \
        -machine q35,accel=kvm \
        -cpu host \
        -smp "$CPUS",sockets=1,cores="$CPUS",threads=1 \
        -m "$MEM" \
        -object "$(ram_backend)" \
        -numa node,memdev=mem0 \
        -rtc base=utc \
        -drive file="$DISK",if=none,id=disk0,format=qcow2,cache=none,aio=native,discard=unmap \
        -device virtio-blk-pci,drive=disk0,bootindex=1 \
        -netdev user,id=nat,ipv6=off \
        -device virtio-net-pci,netdev=nat \
        -netdev tap,id=lab,ifname="$LAB_TAP",script=no,downscript=no"$(vhost)" \
        -device virtio-net-pci,netdev=lab,mac="$LAB_MAC" \
        -device virtio-rng-pci \
        -device qemu-xhci -device usb-tablet \
        -monitor unix:"$MONITOR",server,nowait \
        -device virtio-serial-pci \
        -chardev socket,id=qga0,path="$QGA",server=on,wait=off \
        -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0 \
        -chardev qemu-vdagent,id=vdagent0,name=vdagent,clipboard=on,mouse=off \
        -device virtserialport,chardev=vdagent0,name=com.redhat.spice.0 \
        -chardev socket,id=vfs0,path="$VFS_SOCK" \
        -device vhost-user-fs-pci,chardev=vfs0,tag=share \
        -vga none -device virtio-vga \
        -object tls-creds-anon,id=vnctls,endpoint=server \
        -object secret,id=vncpw,file="$VNC_PASS",format=raw \
        -display vnc="$VNC_ADDR":2,tls-creds=vnctls,password-secret=vncpw
}

monitor() {
    [ -S "$MONITOR" ] || die "no monitor socket at $MONITOR -- is the VM running?"
    python3 -c 'import socket,sys,time
s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall(sys.argv[2].encode()+b"\n")
time.sleep(0.5)' "$MONITOR" "$1"
}

# Guest agent first (qemu-guest-agent, if Kali has it running), else the power button.
shutdown_guest() {
    if [ -S "$QGA" ] && python3 -c 'import json,socket,sys
s=socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect(sys.argv[1])
s.sendall(json.dumps({"execute":"guest-sync","arguments":{"id":4242}}).encode()+b"\n")
buf=b""
while b"\n" not in buf:
    c=s.recv(4096)
    if not c: sys.exit(1)
    buf+=c
if json.loads(buf.splitlines()[0]).get("return")!=4242: sys.exit(1)
s.sendall(json.dumps({"execute":"guest-shutdown","arguments":{"mode":"powerdown"}}).encode()+b"\n")' "$QGA" 2>/dev/null; then
        echo "kali-vm: guest agent shutdown sent"
    else
        echo "kali-vm: no guest agent answer; pressing the ACPI power button"
        monitor system_powerdown
    fi
}

case "${1:-}" in
    create) create "${2:-}" ;;
    run)    run ;;
    stop)   shutdown_guest ;;
    reset)  reset ;;
    *) sed -n '/^# Usage/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
