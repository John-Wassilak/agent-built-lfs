# SPDX-License-Identifier: MIT
# agent-built-lfs -- uid policy routing for the Windows 11 guest (see win11vm-route)
# Copyright (c) 2026 John Wassilak
#
# Before wg1 and before the guest, so the unreachable default in table 51 exists
# whether or not wg1 ever comes up.

[Unit]
Description=Policy routing for the win11vm user (Windows 11 guest via wg1)
Before=wg-quick@wg1.service win11-vm@run.service win11-vm@install.service
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/win11vm-route up
ExecStop=/usr/local/sbin/win11vm-route down

[Install]
WantedBy=multi-user.target
