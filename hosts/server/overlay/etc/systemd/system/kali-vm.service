# SPDX-License-Identifier: MIT
# agent-built-lfs -- Kali lab guest as a unit
# Copyright (c) 2026 John Wassilak
#
# Runs as kalivm, which owns the lab-kali tap. Not enabled at boot; `systemctl start
# kali-vm` when a lab needs it. ExecStop asks the guest to shut down and waits for qemu
# to exit, as win11-vm@.service does.
#
# TemporaryFileSystem: guest RAM, as in win11-vm@.service, which explains each option.
# size= must stay above KALI_MEM.

[Unit]
Description=Kali Linux lab guest
After=systemd-networkd.service wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=simple
User=kalivm
Group=kalivm
TemporaryFileSystem=/run/kalivm-ram:huge=advise,size=8G,mode=1777
ExecStart=/usr/local/bin/kali-vm run
ExecStop=/bin/sh -c '/usr/local/bin/kali-vm stop; while kill -0 $MAINPID 2>/dev/null; do sleep 1; done'
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
