files=`cd /usr/lib/gcc/x86_64-pc-linux-gnu/15.2.0/include-fixed; find . -type l -print 2>/dev/null`; \
if [ $? -eq 0 ]; then \
  dir=`cd include-fixed; ${PWDCMD-pwd}`; \
  for i in $files; do \
    dest=`ls -ld /usr/lib/gcc/x86_64-pc-linux-gnu/15.2.0/include-fixed/$i | sed -n 's/.*-> //p'`; \
    if expr "$dest" : "$dir.*" > /dev/null; then \
      rm -f /usr/lib/gcc/x86_64-pc-linux-gnu/15.2.0/include-fixed/$i; \
      ln -s `echo $i | sed "s|/[^/]*|/..|g" | sed 's|/..$||'``echo "$dest" | sed "s|$dir||"` /usr/lib/gcc/x86_64-pc-linux-gnu/15.2.0/include-fixed/$i; \
    fi; \
  done; \
fi
