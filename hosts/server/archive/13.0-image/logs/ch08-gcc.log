srcdirstrip=`echo "../../gcc" | sed 's/[].[^$\\*|]/\\\\&/g'`; \
for file in $headers; do \
  if [ -f $file ] ; then \
    path=$file; \
  elif [ -f ../../gcc/$file ]; then \
    path=../../gcc/$file; \
  else continue; \
  fi; \
  case $path in \
  "../../gcc"/analyzer/* \
  | "../../gcc"/config/* | "../../gcc"/common/config/* \
  | "../../gcc"/c-family/* | "../../gcc"/*.def ) \
    base=`echo "$path" | sed -e "s|$srcdirstrip/||"`;; \
  *) base=`basename $path` ;; \
  esac; \
  dest=/usr/lib/gcc/x86_64-pc-linux-gnu/15.2.0/plugin/include/$base; \
  echo /usr/bin/install -c -m 644 $path $dest; \
  dir=`dirname $dest`; \
  /bin/sh ../../gcc/../mkinstalldirs $dir; \
  /usr/bin/install -c -m 644 $path $dest; \
done
(cd `${PWDCMD-pwd}`/include-fixed ; \
