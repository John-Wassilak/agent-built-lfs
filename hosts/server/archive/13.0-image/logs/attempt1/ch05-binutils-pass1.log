      ln /mnt/lfs/tools/bin/$k /mnt/lfs/tools/x86_64-lfs-linux-gnu/bin/$j >/dev/null 2>/dev/null \
	||  /bin/sh ./libtool --mode=install /usr/bin/install -c $i /mnt/lfs/tools/x86_64-lfs-linux-gnu/bin/$j; \
    fi; \
  else true; \
  fi; \
done
