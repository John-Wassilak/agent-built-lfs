# Menu entry for laptop (2026-09-25): TigerVNC viewer to server's :0 over wg0.
# `server` is 10.0.0.4 in /etc/hosts; server's x0vncserver listens there only. See
# hosts/server/BUILD-REPORT.md, "TigerVNC: laptop controls this display over WireGuard".
# Runs ~/.local/bin/vnc-server, which takes the password from pass-auto (vnc/server).
# That script passes -RemoteResize=0, so the viewer never asks server to match this
# window. server refuses anyway (AcceptSetDesktopSize=0).
[Desktop Entry]
Type=Application
Name=Server Desktop (VNC)
GenericName=Remote desktop viewer
Comment=View and control server's display over WireGuard
Exec=/home/john/.local/bin/vnc-server
Icon=tigervnc
Terminal=false
StartupWMClass=vncviewer
Categories=Network;RemoteAccess;
