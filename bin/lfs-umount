#!/bin/bash
# SPDX-License-Identifier: MIT
# agent-built-lfs -- unmount the virtual kernel filesystems
# Copyright (c) 2026 John Wassilak

# Unmount the virtual kernel filesystems from the LFS tree, deepest first.
# Run before archiving, and before doing anything destructive to $LFS.
#
# Resolves the tree the same way every other bin/ tool does (--host, else $LFS_HOST,
# else the hostname) rather than assuming /mnt/lfs -- a host built in-repo (laptop's
# chroot_tree points inside this checkout, not /mnt/lfs) was silently a no-op here.
set -u
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

HOST=""
while [ $# -gt 0 ]; do
    case "$1" in
        --host) HOST=$2; shift 2 ;;
        --host=*) HOST=${1#--host=}; shift ;;
        *) echo "usage: lfs-umount [--host NAME]" >&2; exit 2 ;;
    esac
done

LFS=$(LFS_UMOUNT_HOST="$HOST" python3 -c "
import os, sys
sys.path.insert(0, '$SCRIPT_DIR')
import lfshost
h = lfshost.resolve(os.environ.get('LFS_UMOUNT_HOST') or None)
print(h.chroot_tree)
") || exit 1

for m in /dev/shm /dev/pts /dev /proc /sys /run; do
    tgt="$LFS$m"
    if grep -qE " $tgt " /proc/mounts; then
        sudo umount -v "$tgt" || sudo umount -lv "$tgt"
    fi
done

echo
still=$(grep -E " $LFS/" /proc/mounts | awk '{print $2}')
if [ -n "$still" ]; then
    echo "STILL MOUNTED:"; echo "$still"; exit 1
fi
echo "clean: nothing mounted under $LFS"
