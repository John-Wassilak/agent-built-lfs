#!/usr/bin/env python3
"""LFS 13.0-systemd build driver.

Runs plan steps in book order, in the right privilege context, with per-package logs,
timing, resumable state, and (for Chapter 8) an installed-file manifest.

  lfsbuild --status                  what is done, what is next
  lfsbuild --list [--chapter 08]     show the plan
  lfsbuild --only ch05-glibc         run one step
  lfsbuild --from ch06-m4 [--to X]   run a range
  lfsbuild --resume                  run everything not yet completed
  lfsbuild --dry-run ...             print the generated script, run nothing

The unpack / cd / cleanup wrapper from the book's General Instructions is supplied here,
not stored in recipes. Source directory names are read from the tarball itself rather
than guessed, because several do not match their filename (tcl8.6.17-src.tar.gz ->
tcl8.6.17, elfutils ships libelf, etc).
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time

ROOT = "/home/john/lfs"
LFS = "/mnt/lfs"
PLAN = f"{ROOT}/state/plan.json"
DONE = f"{ROOT}/state/completed"
TIMINGS = f"{ROOT}/state/timings.tsv"
LOGS = f"{ROOT}/logs"
RECIPES = f"{ROOT}/recipes"
MANIFESTS = f"{ROOT}/manifests"
BUILDDIR = f"{LFS}/sources/.build"          # /sources/.build inside the chroot
JOBS = os.cpu_count() or 4

VKFS = ["/dev", "/dev/pts", "/proc", "/sys", "/run"]

# Steps the driver handles specially rather than executing verbatim.
SPECIAL = {
    "ch07-chroot": "verify",     # book's command is an interactive shell; we verify instead
    "ch10-grub": "skip",         # deferred to the USB phase: no target device yet
    "ch08-pkgmgt": "skip",       # discussion, no commands to run
    "ch08-aboutdebug": "skip",   # discussion
    "ch11-getcounted": "skip",   # informational
    "ch11-whatnow": "skip",      # informational
    "ch11-afterlfs": "skip",     # informational
    "ch11-reboot": "skip",       # we are not booting this tree; Phase 6 tars it instead
}

# Install roots scanned for the Chapter 8 manifest. /sources is deliberately absent:
# builds happen there and would swamp the manifest.
MANIFEST_ROOTS = "/usr /etc /opt /var /boot /srv /root /bin /sbin /lib"


def load_plan():
    return json.load(open(PLAN))


def completed():
    if not os.path.exists(DONE):
        return set()
    return {l.strip() for l in open(DONE) if l.strip()}


def mark_done(name):
    with open(DONE, "a") as f:
        f.write(name + "\n")


def mounted(path):
    with open("/proc/mounts") as f:
        return any(l.split()[1] == path for l in f)


def vkfs_state():
    return {m: mounted(LFS + m) for m in VKFS}


def srcdir_of(tarball):
    """Top-level directory inside the tarball. Read, not guessed."""
    out = subprocess.run(
        ["tar", "-tf", f"{LFS}/sources/{tarball}"],
        capture_output=True, text=True, check=True,
    ).stdout
    for line in out.splitlines():
        top = line.split("/")[0]
        if top:
            return top
    raise RuntimeError(f"cannot determine source dir for {tarball}")


def free_gb():
    st = os.statvfs(LFS)
    return st.f_bavail * st.f_frsize / 1024**3


def build_script(step, srcdir):
    """Assemble the runnable script: book wrapper + reviewed recipe."""
    name = step["name"]
    chroot = step["context"] == "chroot"
    src = "/sources" if chroot else f"{LFS}/sources"
    recipe = open(f"{RECIPES}/{name}.sh").read()

    L = [
        "#!/bin/bash",
        f"# generated by lfsbuild for step {step['seq']} ({step['order']}) {name}",
        "set -e",
        "set -o pipefail",
        "",
    ]

    want_manifest = chroot and step["chapter"] == "08"
    if want_manifest:
        L += [
            "# --- manifest stamp (installed-file provenance) ---",
            "rm -f /tmp/.lfsbuild-stamp",
            "touch /tmp/.lfsbuild-stamp",
            "",
        ]

    if step["tarball"]:
        L += [
            "# --- unpack (book General Instructions) ---",
            f'cd "{src}"',
            f'rm -rf "{srcdir}"',
            f'tar -xf "{step["tarball"]}"',
            f'cd "{srcdir}"',
            "",
        ]

    L += ["# --- recipe ---", recipe, ""]

    if step["tarball"]:
        L += [
            "# --- cleanup (book General Instructions) ---",
            f'cd "{src}"',
            f'rm -rf "{srcdir}"',
            "",
        ]

    if want_manifest:
        L += [
            "# --- manifest capture ---",
            f"find {MANIFEST_ROOTS} -xdev -newer /tmp/.lfsbuild-stamp "
            f"! -type d 2>/dev/null | sort > /tmp/manifest.{name}.txt || true",
            f'echo "manifest: $(wc -l < /tmp/manifest.{name}.txt) files"',
            "",
        ]

    return "\n".join(L)


def exec_argv(step, script_path):
    """Command line for the step's privilege context."""
    ctx = step["context"]
    term = os.environ.get("TERM", "dumb")
    inner = script_path.replace(f"{LFS}/sources", "/sources")

    if ctx == "lfs":
        # Reproduce the book's login environment exactly by sourcing the .bashrc that
        # ch04-settingenvironment created, inside an empty environment.
        return [
            "sudo", "-u", "lfs",
            "env", "-i", "HOME=/home/lfs", f"TERM={term}", "PS1=\\u:\\w\\$ ",
            "/bin/bash", "--noprofile", "--norc", "-c",
            f'set -e; [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"; '
            f'exec /bin/bash "{script_path}"',
        ]

    if ctx == "root-host":
        return [
            "sudo",
            f"LFS={LFS}",
            f"LFS_TGT={os.uname().machine}-lfs-linux-gnu",
            f"MAKEFLAGS=-j{JOBS}",
            "/bin/bash", script_path,
        ]

    # chroot -- matches the book's 7.4 invocation
    return [
        "sudo", "chroot", LFS, "/usr/bin/env", "-i",
        "HOME=/root", f"TERM={term}", "PS1=(lfs chroot) \\u:\\w\\$ ",
        "PATH=/usr/bin:/usr/sbin",
        f"MAKEFLAGS=-j{JOBS}", f"TESTSUITEFLAGS=-j{JOBS}",
        "/bin/bash", "--login", "-c", f'/bin/bash "{inner}"',
    ]


def preflight(step):
    """Refuse to run a step whose preconditions are not met."""
    ctx = step["context"]
    if free_gb() < 8:
        return f"only {free_gb():.1f} GB free on {LFS}; need >= 8 GB headroom"
    if ctx == "chroot":
        missing = [m for m, ok in vkfs_state().items() if not ok]
        if missing:
            return (f"virtual kernel filesystems not mounted: {', '.join(missing)}. "
                    f"Run ch07-kernfs first.")
    if ctx == "lfs":
        if not os.path.isdir("/home/lfs"):
            return "the lfs user does not exist yet; run ch04-addinguser first"
    return None


def verify_chroot():
    r = subprocess.run(
        ["sudo", "chroot", LFS, "/usr/bin/env", "-i", "PATH=/usr/bin:/usr/sbin",
         "/bin/bash", "--login", "-c", "echo chroot-ok; uname -m; ls -d /usr/bin"],
        capture_output=True, text=True,
    )
    return r.returncode == 0, (r.stdout + r.stderr).strip()


def run_step(step, dry=False):
    name = step["name"]
    special = SPECIAL.get(name)

    if special == "skip":
        print(f"  SKIP  {name}  (informational / deferred)")
        mark_done(name)
        return True

    if special == "verify":
        ok, out = verify_chroot()
        print(f"  {'OK   ' if ok else 'FAIL '} {name}  (chroot entry verification)")
        for l in out.splitlines():
            print(f"        {l}")
        if ok:
            mark_done(name)
        return ok

    problem = preflight(step)
    if problem and not dry:
        print(f"  BLOCKED {name}: {problem}")
        return False

    srcdir = srcdir_of(step["tarball"]) if step["tarball"] else None
    script = build_script(step, srcdir)

    path = f"{BUILDDIR}/{name}.sh"

    if dry:
        print(f"--- {name} ({step['context']}) -> {path} ---")
        print(script)
        print("--- argv ---")
        print(" ".join(exec_argv(step, path)))
        return True

    # Staged root-owned and world-readable: the lfs user needs to read and execute
    # these, not own them. Owning them would also fail before ch04-addinguser runs.
    subprocess.run(["sudo", "install", "-d", "-m", "0755", BUILDDIR], check=True)
    with open("/tmp/_lfsstep.sh", "w") as f:
        f.write(script)
    subprocess.run(["sudo", "install", "-m", "0755", "/tmp/_lfsstep.sh", path], check=True)

    argv = exec_argv(step, path)
    log = f"{LOGS}/{name}.log"
    print(f"  RUN   {step['seq']:3}/{133} {name:28} [{step['context']}] "
          f"src={srcdir or '-'}", flush=True)

    t0 = time.time()
    with open(log, "w") as lf:
        lf.write(f"# {name}  context={step['context']}  {time.ctime()}\n")
        lf.write(f"# argv: {' '.join(argv)}\n\n")
        lf.flush()
        rc = subprocess.run(argv, stdout=lf, stderr=subprocess.STDOUT).returncode
    dt = time.time() - t0

    with open(TIMINGS, "a") as tf:
        tf.write(f"{name}\t{step['context']}\t{dt:.1f}\t{rc}\n")

    if rc == 0:
        # Harvest the Chapter 8 manifest out of the chroot.
        mf = f"{LFS}/tmp/manifest.{name}.txt"
        if os.path.exists(mf):
            os.makedirs(MANIFESTS, exist_ok=True)
            subprocess.run(["sudo", "cp", mf, f"{MANIFESTS}/{name}.txt"], check=False)
            subprocess.run(["sudo", "chown", f"{os.getuid()}:{os.getgid()}",
                            f"{MANIFESTS}/{name}.txt"], check=False)
            subprocess.run(["sudo", "rm", "-f", mf], check=False)
            n = sum(1 for _ in open(f"{MANIFESTS}/{name}.txt"))
            print(f"        OK  {dt/60:.1f} min   manifest: {n} files")
        else:
            print(f"        OK  {dt/60:.1f} min")
        mark_done(name)
        return True

    print(f"        FAILED rc={rc} after {dt/60:.1f} min -- see {log}")
    print("        last lines:")
    tail = subprocess.run(["tail", "-25", log], capture_output=True, text=True).stdout
    for l in tail.splitlines():
        print(f"        | {l}")
    return False


def cmd_status(plan):
    done = completed()
    print(f"completed: {len(done)}/{len(plan)}")
    nxt = [s for s in plan if s["name"] not in done]
    if nxt:
        s = nxt[0]
        print(f"next     : {s['seq']} ({s['order']}) {s['name']} [{s['context']}]")
    else:
        print("next     : -- all steps complete --")
    print(f"free     : {free_gb():.1f} GB on {LFS}")
    st = vkfs_state()
    print("vkfs     : " + ", ".join(f"{m}={'up' if v else 'down'}" for m, v in st.items()))
    if os.path.exists(TIMINGS):
        tot = sum(float(l.split("\t")[2]) for l in open(TIMINGS) if l.count("\t") >= 3)
        print(f"buildtime: {tot/3600:.2f} h so far")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--only")
    ap.add_argument("--from", dest="frm")
    ap.add_argument("--to")
    ap.add_argument("--chapter")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true", help="re-run even if completed")
    a = ap.parse_args()

    plan = load_plan()
    done = completed()

    if a.status:
        return cmd_status(plan)

    sel = plan
    if a.chapter:
        sel = [s for s in sel if s["chapter"] == a.chapter.zfill(2)]
    if a.only:
        sel = [s for s in sel if s["name"] == a.only]
        if not sel:
            sys.exit(f"no such step: {a.only}")
    if a.frm:
        i = next((n for n, s in enumerate(plan) if s["name"] == a.frm), None)
        if i is None:
            sys.exit(f"no such step: {a.frm}")
        sel = [s for s in sel if s["seq"] >= plan[i]["seq"]]
    if a.to:
        j = next((n for n, s in enumerate(plan) if s["name"] == a.to), None)
        if j is None:
            sys.exit(f"no such step: {a.to}")
        sel = [s for s in sel if s["seq"] <= plan[j]["seq"]]

    if a.list:
        for s in sel:
            flag = "x" if s["name"] in done else " "
            print(f"[{flag}] {s['seq']:3} {s['order']:>6} {s['context']:9} "
                  f"{s['name']:28} {s['tarball']}")
        return

    if not (a.resume or a.only or a.frm or a.chapter):
        sys.exit("nothing selected; use --resume, --only, --from, or --chapter")

    if not a.force:
        sel = [s for s in sel if s["name"] not in done]
    if not sel:
        print("nothing to do; all selected steps already complete")
        return

    print(f"running {len(sel)} step(s), {JOBS} jobs\n")
    for s in sel:
        if not run_step(s, dry=a.dry_run):
            print(f"\nSTOPPED at {s['name']}")
            sys.exit(1)
    print("\nall selected steps complete")
    cmd_status(load_plan())


if __name__ == "__main__":
    main()
