# Per-host build logs: large, machine-specific, and reproducible by re-running a step.
hosts/*/logs/
hosts/*/state/*.tmp

# The books are upstream content, fetched not authored. Same release for every host.
book/

# Upstream source is never vendored here. The repo records what to fetch (urls.txt) and
# what it must hash to (blfs-md5), which is enough to reproduce a build; carrying the
# tarballs themselves put 63 MB of redownloadable node/git/curl into git history for no
# gain. Extracted upstream trees are out for the same reason.
sources-staging/
snapshots/
blfs-staging/*.tar.*
blfs-staging/*.tgz
blfs-staging/*.zip
blfs-staging/bsu/
blfs-staging/certdata.txt
*.tar.gz
*.tar.zst

__pycache__/

# laptop's chroot tree (host.toml build.chroot_tree): this machine has no spare
# partition, so the LFS build lives in a plain directory here instead of /mnt/lfs.
# Tens of GB of build/install output, none of it reproducible-by-git -- rebuilt by
# re-running the plan, same as any other host's tree.
/lfs/

# Per-user Claude Code settings. Ignored globally on the machine this was built on,
# which does not travel with a clone.
.claude/settings.local.json

# Session-local scheduler lock (pid/session id/timestamp) -- not project content.
.claude/scheduled_tasks.lock
