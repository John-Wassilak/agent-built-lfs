[Unit]
Description=Set the CPU frequency governor (kernel default is 'userspace', which never scales)
# cpufreq policies appear once intel_pstate has registered, which happens in
# early boot -- but only after the CPU is fully up, so run in the sysinit stage.
DefaultDependencies=no
After=sysinit.target
Before=basic.target
ConditionPathIsDirectory=/sys/devices/system/cpu/cpu0/cpufreq

[Service]
Type=oneshot
RemainAfterExit=yes
# Why this exists: this kernel is built with CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
# (inherited from `make defconfig`; bin/kernel-config.sh never overrode it). The
# userspace governor takes its frequency from a process writing scaling_setspeed
# -- and nothing on this system ever does. So every core stayed pinned at the
# 1600 MHz minimum instead of the i5-2500K's 3400 MHz all-core turbo: a measured
# 2.1x loss on any sustained CPU work. Found while diagnosing a 0.51x x264 encode
# (2026-08-27); the same encode measured 0.84x once the clock was released.
#
# schedutil, not performance: measured to reach the same 3403 MHz under sustained
# encode load (x264 1080p medium: 0.719x vs 0.735x on performance), without
# holding max clock while the machine is idle.
ExecStart=/bin/sh -c 'for p in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do [ -w "$p" ] && echo schedutil > "$p"; done; exit 0'

[Install]
WantedBy=multi-user.target
