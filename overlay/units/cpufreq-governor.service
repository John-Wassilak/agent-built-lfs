[Unit]
Description=Set the CPU frequency governor (kernel default is 'userspace', which never scales)
# cpufreq policies appear once intel_pstate has registered, which happens in
# early boot -- but only after the CPU is fully up, so run in the sysinit stage.
DefaultDependencies=no
After=sysinit.target
Before=basic.target
ConditionPathIsDirectory=/sys/devices/system/cpu/cpu0/cpufreq

[Service]
Type=oneshot
RemainAfterExit=yes
# Why this exists: this kernel is built with CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
# (inherited from `make defconfig`; bin/kernel-config.sh never overrode it). The
# userspace governor takes its frequency from a process writing scaling_setspeed
# -- and nothing on this system ever does. So every core stayed pinned at the
# 1600 MHz minimum instead of the i5-2500K's 3400 MHz all-core turbo: a measured
# 2.1x loss on any sustained CPU work. Found while diagnosing a 0.51x x264 encode
# (2026-08-27); the same encode measured 0.84x once the clock was released.
#
# schedutil, not performance: measured to reach the same 3403 MHz under sustained
# encode load (x264 1080p medium: 0.719x vs 0.735x on performance), without
# holding max clock while the machine is idle.
#
# Not every host exposes schedutil: intel_pstate in active mode (laptop's
# i7-6600U) only lists 'performance'/'powersave' in scaling_available_governors
# -- writing 'schedutil' there fails with EINVAL. Found on laptop's first post-
# deploy boot audit (2026-09-03): the old unconditional `exit 0` masked that
# failure as success while every core sat on 'powersave'. Prefer schedutil when
# it exists; otherwise leave the driver's own default alone rather than forcing
# 'performance' -- intel_pstate active-mode 'powersave' is HWP-driven and already
# scales under load, unlike a plain cpufreq 'powersave' pin, so there is nothing
# to fix on those hosts. Never silently succeed: log what happened either way.
ExecStart=/bin/sh -c '\
  for p in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do \
    avail="$(cat "$(dirname "$p")/scaling_available_governors" 2>/dev/null)"; \
    case " $avail " in \
      *" schedutil "*) [ -w "$p" ] && echo schedutil > "$p" && echo "$p: set schedutil" || echo "$p: schedutil available but not writable"; ;; \
      *) echo "$p: no schedutil available (driver exposes: $avail); leaving default ($(cat "$p" 2>/dev/null))"; ;; \
    esac; \
  done'

[Install]
WantedBy=multi-user.target
